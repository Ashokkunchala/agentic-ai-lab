# Copy to .env and fill in what you need. .env is gitignored; this file is not.
# Nothing in this repository requires any of these to run. Every lesson works
# offline with a deterministic echo model.

# --- model provider (optional) -------------------------------------------
# Only needed if you implement a real adapter. See shared/model.py.
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GOOGLE_API_KEY=

# --- runtime behaviour ----------------------------------------------------
# Read by shared/config.py. These now have real readers, unlike in earlier
# revisions where they were documented but unused.
AGENT_MODEL_NAME=echo
AGENT_MAX_STEPS=8
AGENT_REQUIRE_APPROVAL=true

# --- cloudflare worker (optional) ----------------------------------------
# Used by 13-cloudflare/worker.test.mjs and by `wrangler dev`.
AGENT_SHARED_SECRET=